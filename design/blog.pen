                      "name": "Post Desc",
                      "fill": "$ink-soft",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Agonara is a bring-your-own-agent environment for learning programs. A curator builds a program from sources, students follow it and prove they understand, and the agent you already use does the drafting, quizzing and grading.",
                      "lineHeight": 1.55,
                      "fontFamily": "$font-body",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
